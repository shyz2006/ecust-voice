{
  "manifest_version": 3,
  "name": "华理校园笔记 · 本机同步助手",
  "version": "1.1.0",
  "description": "在本机正常登录后定时读取华理公开搜索卡片并同步到校园平台，保留手动导出。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "导出当前页华理笔记"
  },
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://smydashuaige.2026515.xyz/pulse/api/xhs-browser/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
