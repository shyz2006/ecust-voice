HOST=0.0.0.0
PORT=5000
DB_HOST=db
DB_PORT=5432
DB_USER=bettafish
DB_PASSWORD=your_db_password_here
DB_NAME=bettafish
DB_CHARSET=utf8mb4
DB_DIALECT=postgresql
POSTGRES_PORT=5444

# LLM Engines Configuration
INSIGHT_ENGINE_API_KEY=your_api_key_here
INSIGHT_ENGINE_BASE_URL=https://api.openai.com/v1
INSIGHT_ENGINE_MODEL_NAME=gpt-4o-mini

MEDIA_ENGINE_API_KEY=your_api_key_here
MEDIA_ENGINE_BASE_URL=https://api.openai.com/v1
MEDIA_ENGINE_MODEL_NAME=gpt-4o-mini

QUERY_ENGINE_API_KEY=your_api_key_here
QUERY_ENGINE_BASE_URL=https://api.openai.com/v1
QUERY_ENGINE_MODEL_NAME=gpt-4o-mini

REPORT_ENGINE_API_KEY=your_api_key_here
REPORT_ENGINE_BASE_URL=https://api.openai.com/v1
REPORT_ENGINE_MODEL_NAME=gpt-4o-mini

MINDSPIDER_API_KEY=your_api_key_here
MINDSPIDER_BASE_URL=https://api.openai.com/v1
MINDSPIDER_MODEL_NAME=gpt-4o-mini

FORUM_HOST_API_KEY=your_api_key_here
FORUM_HOST_BASE_URL=https://api.openai.com/v1
FORUM_HOST_MODEL_NAME=gpt-4o-mini

KEYWORD_OPTIMIZER_API_KEY=your_api_key_here
KEYWORD_OPTIMIZER_BASE_URL=https://api.openai.com/v1
KEYWORD_OPTIMIZER_MODEL_NAME=gpt-4o-mini

# Failover & Resilience
LLM_FALLBACK_MODELS=deepseek-v4-pro
LLM_MODEL_COOLDOWN_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_DELAY=15
LLM_RETRY_BACKOFF_FACTOR=2
LLM_RETRY_MAX_DELAY=60

# Search Gateways
TAVILY_API_KEY=
SEARCH_TOOL_TYPE=bocha
ANSPIRE_BASE_URL=
ANSPIRE_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1
BOCHA_WEB_SEARCH_API_KEY=your_bocha_api_key

GRAPHRAG_ENABLED=false
GRAPHRAG_MAX_QUERIES=5

# Web Authentication
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=your_password_here
