FROM ghcr.io/666ghj/bettafish:latest

WORKDIR /app

# Keep the upstream image and layer only the local Bocha compatibility changes & task isolation.
COPY app.py app.py
COPY templates/index.html templates/index.html
COPY templates/login.html templates/login.html
COPY static/css/bettafish.css static/css/bettafish.css
COPY static/js/app-ui.js static/js/app-ui.js
COPY static/img/ecust-lawn.jpg static/img/ecust-lawn.jpg
COPY static/task_sidebar.js static/task_sidebar.js
COPY static/task_isolation.js static/task_isolation.js
COPY ForumEngine/task_store.py ForumEngine/task_store.py
COPY ForumEngine/monitor.py ForumEngine/monitor.py
COPY ForumEngine/llm_host.py ForumEngine/llm_host.py
COPY utils/task_runtime.py utils/task_runtime.py
